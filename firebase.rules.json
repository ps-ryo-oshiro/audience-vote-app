{
  "rules": {
    ".read": false,
    ".write": false,
    "audienceApp": {
      "teams":    { ".read": true, ".write": true },
      "settings": { ".read": true, ".write": true },
      "votes": {
        ".read": true,
        "$voteId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['teamId', 'voterToken', 'votedAt'])"
        }
      }
    }
  }
}
